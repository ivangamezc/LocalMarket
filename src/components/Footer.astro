---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="relative z-10 mt-20 border-t border-white/5 bg-[#2a2a2a]/30 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-8 py-16">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
            
            <div class="col-span-1 md:col-span-2">
                <div class="text-3xl font-black tracking-tighter uppercase italic mb-6">
                    LOCAL<span class="text-[#facc15]">MKT</span>
                </div>
                <p class="text-gray-400 text-sm max-w-sm leading-relaxed mb-8">
                    Redefiniendo el concepto de moda local. Calidad industrial, diseño resiliente y fabricación ética desde el corazón de la ciudad.
                </p>
                <div class="flex gap-4">
                    <a href="#" class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center hover:bg-[#facc15] hover:text-black transition-all" aria-label="Instagram">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                    </a>
                    
                    <a href="#" class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center hover:bg-[#facc15] hover:text-black transition-all" aria-label="X (Twitter)">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733 -16z"></path><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"></path></svg>
                    </a>
                    
                    <a href="#" class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center hover:bg-[#facc15] hover:text-black transition-all" aria-label="Facebook">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0 -5 5v3h-3v4h3v8h4v-8h3l1 -4h-4v-3a1 1 0 0 1 1 -1h3z"></path></svg>
                    </a>
                </div>
            </div>

            <div>
                <h4 class="text-[#facc15] text-[10px] font-black uppercase tracking-[0.3em] mb-6">Explorar</h4>
                <ul class="flex flex-col gap-4 text-sm font-medium text-gray-300">
                    <li><a href="/ropa" class="hover:text-white transition-colors">Ropa</a></li>
                    <li><a href="/accesorios" class="hover:text-white transition-colors">Accesorios</a></li>
                    <li><a href="/calzado" class="hover:text-white transition-colors">Calzado</a></li>
                </ul>
            </div>

            <div>
                <h4 class="text-[#facc15] text-[10px] font-black uppercase tracking-[0.3em] mb-6">Ayuda</h4>
                <ul class="flex flex-col gap-4 text-sm font-medium text-gray-300">
                    <li><a href="/envios" class="hover:text-white transition-colors">Envíos</a></li>
                    <li><a href="/devoluciones" class="hover:text-white transition-colors">Devoluciones</a></li>
                    <li><a href="/faq" class="hover:text-white transition-colors">FAQ</a></li>
                    <li><a href="/contacto" class="hover:text-white transition-colors">Contacto</a></li>
                </ul>
            </div>
        </div>

        <div class="mt-16 pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="text-[10px] text-gray-300 uppercase tracking-widest">
                © {currentYear} LocalMarket. Proyecto Final DAM.
            </p>
            <div class="flex gap-8 text-[10px] text-gray-300 uppercase tracking-widest">
                <a href="/privacidad" class="hover:text-white transition-colors">Privacidad</a>
                <a href="/terminos" class="hover:text-white transition-colors">Términos</a>
            </div>
        </div>
    </div>
</footer>