---
// src/components/TechAnatomy.astro

const hotspots = [
    {
        id: "hs-1",
        top: "20%",
        left: "60%",
        title: "COSTURAS TERMOSELLADAS",
        desc: "Sellado ultrasónico que garantiza un 100% de impermeabilidad contra el clima urbano extremo.",
        align: "right"
    },
    {
        id: "hs-2",
        top: "50%",
        left: "30%",
        title: "CREMALLERAS YKK VISLON®",
        desc: "Sistema de cierre bidireccional con recubrimiento de poliuretano. Cero fricción, máxima durabilidad.",
        align: "left"
    },
    {
        id: "hs-3",
        top: "75%",
        left: "65%",
        title: "NYLON BALÍSTICO 500D",
        desc: "Paneles de refuerzo en zonas de alta abrasión. El mismo material utilizado en equipamiento táctico.",
        align: "right"
    }
];
---

<section class="py-24 px-4 sm:px-8 max-w-7xl mx-auto border-y border-white/5 bg-[radial-gradient(circle_at_center,_rgba(250,204,21,0.03)_0%,_rgba(0,0,0,0)_70%)]">
    
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
        
        <div class="w-full lg:w-1/2 space-y-6">
            <div class="inline-flex items-center gap-3">
                <span class="w-8 h-[2px] bg-[#facc15]"></span>
                <span class="text-[#facc15] text-[10px] font-black uppercase tracking-[0.4em]">I+D Textil //</span>
            </div>
            
            <h2 class="text-4xl sm:text-5xl lg:text-6xl font-black italic uppercase tracking-tighter leading-[0.9] text-white">
                ANATOMÍA <br/>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-gray-400 to-gray-600">DEL EQUIPO.</span>
            </h2>
            
            <p class="text-xs text-gray-400 leading-relaxed tracking-wide max-w-md">
                No diseñamos simple ropa, desarrollamos hardware para el cuerpo. Analiza en detalle los componentes industriales y los tejidos inteligentes que conforman el núcleo de nuestras prendas de alto rendimiento.
            </p>

            <div class="pt-4 flex gap-6">
                <div class="flex flex-col gap-1 border-l border-[#facc15]/30 pl-3">
                    <span class="text-white text-xl font-black">10K</span>
                    <span class="text-[9px] text-gray-500 uppercase tracking-widest">Columna H2O</span>
                </div>
                <div class="flex flex-col gap-1 border-l border-[#facc15]/30 pl-3">
                    <span class="text-white text-xl font-black">DWR</span>
                    <span class="text-[9px] text-gray-500 uppercase tracking-widest">Tratamiento</span>
                </div>
            </div>
        </div>

        <div class="w-full lg:w-1/2 relative">
            <div class="relative w-full aspect-[4/5] lg:aspect-square bg-transparent">
                <div class="w-full h-full rounded-2xl overflow-hidden relative border border-white/10 shadow-[0_0_50px_rgba(0,0,0,0.5)]">
                    <img 
                        src="/chaqueta.jpg" 
                        alt="Anatomía de la prenda" 
                        class="w-full h-full object-cover object-center opacity-80 grayscale-[0.2] hover:grayscale-0 transition-all duration-700"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"></div>
                </div>

                {hotspots.map((spot) => (
                    <div class="absolute z-[100] group" style={`top: ${spot.top}; left: ${spot.left};`}>
                        <button class="relative w-6 h-6 flex items-center justify-center focus:outline-none">
                            <span class="absolute inline-flex h-full w-full rounded-full bg-[#facc15] opacity-50 group-hover:animate-ping"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#facc15]"></span>
                        </button>
                        
                        <div class="absolute top-0 left-8 w-56 bg-[#0a0a0a]/95 backdrop-blur-md border border-[#facc15]/20 p-4 rounded-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-[200] shadow-[0_10px_30px_rgba(0,0,0,0.8)] pointer-events-none">
                            <div class="flex items-center gap-2 mb-2">
                                <div class="w-1.5 h-1.5 bg-[#facc15]"></div>
                                <h4 class="text-white text-[10px] font-black tracking-widest uppercase">{spot.title}</h4>
                            </div>
                            <p class="text-gray-400 text-[11px] leading-relaxed font-mono">{spot.desc}</p>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>