---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Terminal de Acceso | LocalMarket">
    <section class="px-8 py-20 mx-auto min-h-screen flex flex-col justify-center items-center bg-black">
        
        <div class="w-full max-w-sm border border-red-500/30 bg-[#0a0a0a] p-8 rounded-2xl shadow-[0_0_50px_rgba(239,68,68,0.1)]">
            <div class="mb-8 text-center">
                <div class="flex justify-center mb-4">
                    <span class="px-3 py-1 bg-red-500/20 text-red-500 text-[9px] font-black uppercase tracking-[0.4em] rounded-full border border-red-500/50">
                        Área Restringida
                    </span>
                </div>
                <h1 class="text-2xl font-black uppercase text-white tracking-widest">
                    Acceso Admin
                </h1>
            </div>

            <form id="admin-login-form" class="space-y-6">
                <div class="space-y-2">
                    <label class="text-[9px] font-black text-gray-500 uppercase tracking-[0.3em]">Credencial (Email)</label>
                    <input 
                        type="email" 
                        id="admin-email" 
                        required 
                        placeholder="ivangamezcastro@gmail.com" 
                        class="w-full bg-black border border-white/10 rounded-lg px-4 py-3 text-white focus:border-red-500 outline-none transition-all font-mono text-xs"
                    >
                </div>
                <div class="space-y-2">
                    <label class="text-[9px] font-black text-gray-500 uppercase tracking-[0.3em]">Código de Seguridad</label>
                    <input 
                        type="password" 
                        id="admin-password" 
                        required 
                        placeholder="••••••" 
                        class="w-full bg-black border border-white/10 rounded-lg px-4 py-3 text-white focus:border-red-500 outline-none transition-all font-mono text-xs"
                    >
                </div>
                
                <p id="error-msg" class="hidden text-red-500 text-[10px] font-bold text-center uppercase tracking-widest mt-4"></p>

                <button type="submit" id="admin-login-btn" class="w-full mt-6 py-4 bg-red-600 text-white font-black uppercase text-[10px] tracking-[0.3em] rounded-lg hover:bg-red-500 transition-all shadow-[0_0_20px_rgba(239,68,68,0.4)]">
                    Desbloquear Terminal
                </button>
            </form>
        </div>
    </section>
</Layout>

<script>
    import { supabase } from '../lib/supabaseClient';

    const loginForm = document.getElementById('admin-login-form') as HTMLFormElement;
    const loginBtn = document.getElementById('admin-login-btn');
    const errorMsg = document.getElementById('error-msg');

    loginForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const email = (document.getElementById('admin-email') as HTMLInputElement).value;
        const password = (document.getElementById('admin-password') as HTMLInputElement).value;
        const ADMIN_EMAIL = "ivangamezcastro@gmail.com";

        if (errorMsg) errorMsg.classList.add('hidden');
        if (loginBtn) loginBtn.innerText = "VERIFICANDO CREDENCIALES...";

        // 1. Primera barrera: Comprobar que intenta usar tu correo
        if (email !== ADMIN_EMAIL) {
            if (errorMsg) {
                errorMsg.innerText = "ACCESO DENEGADO: Usuario no autorizado.";
                errorMsg.classList.remove('hidden');
            }
            if (loginBtn) loginBtn.innerText = "Desbloquear Terminal";
            return;
        }

        // 2. Segunda barrera: Supabase comprueba tu contraseña real (123456)
        const { error } = await supabase.auth.signInWithPassword({ email, password });
        
        if (error) {
            if (errorMsg) {
                errorMsg.innerText = "ACCESO DENEGADO: Contraseña incorrecta.";
                errorMsg.classList.remove('hidden');
            }
            if (loginBtn) loginBtn.innerText = "Desbloquear Terminal";
        } else {
            // Si todo es correcto, entras al ERP
            if (loginBtn) {
                loginBtn.innerText = "ACCESO CONCEDIDO ✓";
                loginBtn.classList.replace('bg-red-600', 'bg-green-600');
                loginBtn.classList.replace('hover:bg-red-500', 'hover:bg-green-500');
            }
            setTimeout(() => {
                window.location.href = '/admin';
            }, 800);
        }
    });
</script>