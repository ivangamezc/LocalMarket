---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Orden Confirmada | LOCALMKT">
    <section class="px-8 py-24 max-w-3xl mx-auto min-h-screen flex flex-col justify-center">
        
        <div class="reveal mb-12 text-center">
            <div class="relative inline-block">
                <div class="absolute inset-0 bg-[#facc15] blur-2xl opacity-20 animate-pulse"></div>
                <div class="relative w-24 h-24 border-2 border-[#facc15] rounded-full flex items-center justify-center mb-8 mx-auto">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-[#facc15]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                </div>
            </div>
            
            <span class="text-[#facc15] text-[10px] font-black uppercase tracking-[0.6em] mb-4 block">Transacción Completada</span>
            <h1 class="text-5xl md:text-7xl font-black italic uppercase tracking-tighter text-white mb-6">
                ORDEN <br/> RECIBIDA.
            </h1>
        </div>

        <div class="reveal bg-white/[0.02] border border-white/10 rounded-[2rem] overflow-hidden backdrop-blur-md mb-12" style="animation-delay: 0.2s">
            <div class="bg-white/5 px-8 py-4 border-b border-white/10 flex justify-between items-center">
                <span class="text-[9px] font-mono text-gray-400 uppercase tracking-widest">Manifiesto de Carga v.2026</span>
                <div class="flex gap-1">
                    <div class="w-1 h-1 bg-[#facc15] rounded-full"></div>
                    <div class="w-1 h-1 bg-[#facc15] rounded-full"></div>
                </div>
            </div>
            
            <div class="p-8 md:p-12 space-y-10">
                <div class="grid md:grid-cols-2 gap-8">
                    <div>
                        <h4 class="text-[10px] font-black text-[#facc15] uppercase tracking-[0.3em] mb-3">Estado del Envío</h4>
                        <p class="text-xs font-bold text-white uppercase tracking-widest">Procesando en Nodo Sur</p>
                    </div>
                    <div>
                        <h4 class="text-[10px] font-black text-[#facc15] uppercase tracking-[0.3em] mb-3">ID de Seguimiento</h4>
                        <p id="tracking-number" class="text-xs font-mono font-bold text-white uppercase tracking-widest">Generando...</p>
                    </div>
                </div>

                <div class="border-t border-dashed border-white/10 pt-10">
                    <p class="text-[11px] text-gray-400 leading-relaxed uppercase tracking-widest">
                        Tu pedido ha sido registrado en nuestros sistemas. Recibirás un enlace de seguimiento cifrado en tu terminal de correo electrónico una vez que el paquete abandone el centro logístico de Villanueva Mesía.
                    </p>
                </div>

                <div class="flex items-center gap-4 p-4 bg-[#facc15]/10 border border-[#facc15]/20 rounded-xl">
                    <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></div>
                    <span class="text-[9px] font-black text-[#facc15] uppercase tracking-[0.2em]">Entrega estimada: 24/48 Horas Laborables</span>
                </div>
            </div>
        </div>

        <div class="reveal text-center" style="animation-delay: 0.4s">
            <a href="/" class="inline-block px-12 py-5 border border-white/20 text-white font-black uppercase text-[10px] tracking-[0.3em] hover:bg-white hover:text-black transition-all rounded-2xl">
                Volver al Inicio
            </a>
        </div>

    </section>
</Layout>

<script>
    import { cartItems } from '../store/cartStore.js';

    const finalizeOrder = () => {
        // 1. Generar número de seguimiento aleatorio estilo industrial
        const trackingEl = document.getElementById('tracking-number');
        if (trackingEl) {
            const randomID = Math.random().toString(36).toUpperCase().substring(2, 10);
            trackingEl.innerText = `LM-TX-${randomID}`;
        }

        // 2. VACIAR EL CARRITO (Limpiamos la memoria del store)
        setTimeout(() => {
            cartItems.set([]);
            console.log("Sistema: Carrito purgado tras orden completada.");
        }, 500);
    };

    // Ejecutar al cargar la página
    finalizeOrder();
    // Re-ejecutar si se usa View Transitions
    document.addEventListener('astro:after-swap', finalizeOrder);
</script>