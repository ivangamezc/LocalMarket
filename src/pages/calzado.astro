---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import { supabase } from '../lib/supabaseClient';

// Consultamos a la base de datos de Supabase filtrando por tipo de calzado
const { data: calzadoProducts, error } = await supabase
    .from('productos')
    .select('*')
    .in('tipo', ['zapatillas', 'botas']);

if (error) {
    console.error("Error cargando el calzado:", error.message);
}
---

<Layout title="Footwear | LocalMarket">
    <section class="px-8 pt-10 pb-20 max-w-7xl mx-auto min-h-screen">
        
        <div class="mb-24 text-center">
            <div class="flex items-center justify-center gap-3 mb-6">
                <span class="w-12 h-[1px] bg-[#facc15]"></span>
                <span class="text-[#facc15] text-[10px] font-black uppercase tracking-[0.5em]">Catálogo</span>
                <span class="w-12 h-[1px] bg-[#facc15]"></span>
            </div>
            <h1 class="text-6xl md:text-[9rem] font-black tracking-[-0.05em] leading-none uppercase italic bg-gradient-to-b from-gray-100 via-gray-400 to-[#333333] bg-clip-text text-transparent pb-4">
                PASO URBANO.
            </h1>
            <p class="mt-4 text-[10px] md:text-xs uppercase tracking-[0.6em] text-white/40 font-light max-w-2xl mx-auto leading-loose">
                Arquitectura para el movimiento. El soporte fundamental para navegar la infraestructura de la ciudad.
            </p>
        </div>

        <div class="flex flex-col items-center justify-center gap-12 pb-16 mb-20 border-b border-white/5">
            <div class="flex flex-col md:flex-row items-center gap-16 md:gap-32">
                <div class="flex flex-col items-center gap-4">
                    <span class="text-[9px] font-black uppercase tracking-[0.6em] text-[#facc15] mb-2">Colección</span>
                    <div class="flex gap-10">
                        <button class="relative text-[11px] font-bold uppercase tracking-[0.2em] text-white">
                            Todos los modelos
                            <span class="absolute -bottom-2 left-0 w-full h-[2px] bg-[#facc15]"></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            {calzadoProducts && calzadoProducts.length > 0 ? (
                calzadoProducts.map((p) => (
                    <Card id={p.id} title={p.nombre} price={p.precio} category={p.cat} image={p.imagen} />
                ))
            ) : (
                <div class="col-span-full py-20 text-center opacity-40 uppercase tracking-[0.5em] text-[10px]">Próximo Drop disponible en junio</div>
            )}
        </div>
    </section>
</Layout>