---
import Layout from '../layouts/Layout.astro';

const faqs = [
    {
        hex: "0x01",
        categoria: "LOGÍSTICA_DE_RED",
        pregunta: "¿Cuál es el tiempo de entrega del 'Envío Blindado'?",
        respuesta: "Nuestros envíos urbanos se procesan en un ciclo automatizado de 24/48h. El sistema generará una firma criptográfica única y un código de rastreo en tiempo real una vez que el cargamento abandone el nodo de distribución central."
    },
    {
        hex: "0x02",
        categoria: "REVERSIS_DE_KIT",
        pregunta: "¿Cómo funcionan las devoluciones de producto?",
        respuesta: "Dispones de una ventana de redundancia de 14 días desde la verificación de entrega para solicitar la devolución. Para que el protocolo sea aprobado, el hardware textil debe conservar intactos los precintos industriales."
    },
    {
        hex: "0x03",
        categoria: "ESTRUCTURA_MATERIA",
        pregunta: "¿Qué materiales componen la línea técnica 'Resiliente'?",
        respuesta: "Implementamos un compuesto balístico de nylon reforzado de alta densidad, membranas hidrófugas con sellado molecular y algodón orgánico texturizado de alto gramaje. Diseñado bajo estándares militares."
    },
    {
        hex: "0x04",
        categoria: "NODO_PRESENCIAL",
        pregunta: "¿Existe un espacio físico para el tallaje?",
        respuesta: "Negativo. Para optimizar la cadena y garantizar la exclusividad de cada drop, operamos mediante despliegue 100% digital. Cada módulo incluye un escáner de dimensiones y una guía paramétrica exacta."
    }
];
---

<Layout title="SYSTEM_FAQ // LOCALMKT">
    <section class="relative px-4 sm:px-8 py-24 max-w-7xl mx-auto min-h-screen overflow-hidden text-white selection:bg-[#facc15] selection:text-black">
        
        <!-- Overlay de Scanlines (Efecto Monitor CRT) -->
        <div class="pointer-events-none absolute inset-0 z-50 h-full w-full opacity-10 mix-blend-overlay" style="background-image: repeating-linear-gradient(0deg, transparent, transparent 2px, #000 2px, #000 4px);"></div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start relative z-10">
            
            <!-- PANEL IZQUIERDO: HUD Táctico -->
            <div class="lg:col-span-4 lg:sticky lg:top-32 flex flex-col gap-8">
                
                <!-- Radar Visual (Puro CSS) -->
                <div class="relative w-16 h-16 border border-[#facc15]/30 rounded-full flex items-center justify-center bg-[#facc15]/5 overflow-hidden">
                    <div class="absolute inset-0 border-t border-[#facc15] rounded-full animate-[spin_3s_linear_infinite] opacity-50"></div>
                    <div class="absolute w-full h-[1px] bg-[#facc15]/20"></div>
                    <div class="absolute h-full w-[1px] bg-[#facc15]/20"></div>
                    <div class="w-2 h-2 bg-[#facc15] rounded-full animate-pulse shadow-[0_0_10px_#facc15]"></div>
                </div>
                
                <div>
                    <h1 class="text-5xl sm:text-6xl font-black uppercase tracking-tighter leading-[0.85] mb-4">
                        DATA<br/>
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#facc15] to-[#facc15]/50">
                            ARCHIVE.
                        </span>
                    </h1>
                    <p class="text-[10px] text-gray-400 font-mono tracking-[0.2em] uppercase max-w-[250px] border-l-2 border-[#facc15] pl-4">
                        Directorio de respuestas a consultas de red. Acceso autorizado Nivel Gold.
                    </p>
                </div>

                <!-- Telemetría Dinámica -->
                <div class="bg-black/60 border border-white/10 p-5 rounded-sm font-mono text-[10px] uppercase tracking-widest space-y-4 relative">
                    <!-- Esquina cortada visualmente con borde -->
                    <div class="absolute top-0 right-0 w-3 h-3 border-t border-r border-[#facc15]"></div>
                    
                    <div>
                        <div class="flex justify-between text-gray-500 mb-1"><span>System_Load</span><span class="text-[#facc15]">42%</span></div>
                        <div class="w-full h-[2px] bg-white/10"><div class="h-full bg-[#facc15] w-[42%]"></div></div>
                    </div>
                    <div>
                        <div class="flex justify-between text-gray-500 mb-1"><span>Db_Query_Time</span><span class="text-white">0.08ms</span></div>
                        <div class="w-full h-[2px] bg-white/10"><div class="h-full bg-white/50 w-[15%]"></div></div>
                    </div>
                </div>
            </div>

            <!-- PANEL DERECHO: Nodos de Información -->
            <div class="lg:col-span-8 space-y-6">
                {faqs.map((faq, i) => (
                    <div class="faq-item group bg-transparent border-b border-white/10 pb-2 transition-all duration-300 hover:border-[#facc15]/50">
                        
                        <button class="faq-button w-full py-4 text-left flex items-start gap-4 sm:gap-6 cursor-pointer group-hover:pl-4 transition-all duration-300">
                            
                            <!-- Indicador de Memoria -->
                            <span class="font-mono text-[10px] sm:text-xs text-white/30 group-hover:text-[#facc15] transition-colors mt-1">
                                [{faq.hex}]
                            </span>

                            <div class="flex flex-col flex-1 gap-1">
                                <span class="font-mono text-[9px] text-[#facc15]/60 tracking-[0.3em]">
                                    <span class="hidden group-hover:inline opacity-50">&gt; </span>{faq.categoria}
                                </span>
                                <h2 class="text-base sm:text-lg lg:text-xl font-bold uppercase tracking-wide text-white/80 group-hover:text-white transition-colors duration-300">
                                    {faq.pregunta}
                                </h2>
                            </div>
                            
                            <!-- Icono Sci-Fi -->
                            <div class="shrink-0 font-mono text-xl font-light text-[#facc15]/50 group-hover:text-[#facc15] transition-transform duration-300 transform group-[.is-active]:rotate-45 mt-1">
                                +
                            </div>
                        </button>
                        
                        <!-- Contenedor del Acordeón -->
                        <div class="faq-answer max-h-0 overflow-hidden transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">
                            <div class="pl-14 sm:pl-[4.5rem] pr-4 pb-8 pt-2">
                                <div class="relative bg-[#0a0a0a] border border-white/5 p-5 font-mono text-xs text-gray-400 leading-relaxed tracking-wide">
                                    <!-- Decal técnico -->
                                    <div class="absolute -top-[1px] left-4 w-8 h-[2px] bg-[#facc15]"></div>
                                    
                                    <span class="text-[#facc15] font-bold block mb-2 opacity-50 text-[10px]">&gt; DECRYPTING_PAYLOAD...</span>
                                    
                                    <!-- El texto real que será desencriptado por JS -->
                                    <p class="scramble-text text-gray-300 font-sans text-sm" data-original={faq.respuesta}>
                                        {faq.respuesta}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                ))}
            </div>

        </div>
    </section>
</Layout>

<script>
    // Lógica del Scrambler Cyberpunk
    const scrambleLetters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&*<>";
    
    const startScrambleEffect = (element: HTMLElement, finalString: string) => {
        let iteration = 0;
        let interval: ReturnType<typeof setInterval>;
        
        clearInterval(Number(element.dataset.intervalId));
        
        interval = setInterval(() => {
            element.innerText = finalString
                .split("")
                .map((letter, index) => {
                    if(index < iteration) return finalString[index];
                    return scrambleLetters[Math.floor(Math.random() * scrambleLetters.length)];
                })
                .join("");
                
            // Controla la velocidad de desencriptación (fracción sumada por frame)
            if(iteration >= finalString.length){
                clearInterval(interval);
            }
            iteration += 1.5; 
        }, 15); // ms por frame
        
        element.dataset.intervalId = String(interval);
    };

    const setupFaqs = () => {
        const buttons = document.querySelectorAll('.faq-button');
        
        buttons.forEach(button => {
            button.addEventListener('click', () => {
                const item = button.closest('.faq-item');
                const answerContainer = button.nextElementSibling as HTMLElement;
                const textElement = answerContainer?.querySelector('.scramble-text') as HTMLElement;
                
                if (!item || !answerContainer || !textElement) return;

                const isOpen = item.classList.contains('is-active');
                const originalText = textElement.dataset.original || '';

                // Lógica de Acordeón
                document.querySelectorAll('.faq-item').forEach(otherItem => {
                    if (otherItem !== item) {
                        otherItem.classList.remove('is-active');
                        const otherAnswer = otherItem.querySelector('.faq-answer') as HTMLElement;
                        if (otherAnswer) otherAnswer.style.maxHeight = "0px";
                    }
                });

                if (isOpen) {
                    item.classList.remove('is-active');
                    answerContainer.style.maxHeight = "0px";
                } else {
                    item.classList.add('is-active');
                    answerContainer.style.maxHeight = answerContainer.scrollHeight + "px";
                    
                    // Disparamos el efecto de "Hackeo" sobre el texto al abrir
                    startScrambleEffect(textElement, originalText);
                }
            });
        });
    }

    setupFaqs();
    document.addEventListener('astro:page-load', setupFaqs);
</script>

<style>
    .faq-button { -webkit-tap-highlight-color: transparent; }
    .faq-button:focus { outline: none; }
</style>