---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import { supabase } from '../lib/supabaseClient'; // Conexión a la nube

// 1. Pedimos a la BD todos los productos que sean prendas de ropa
const { data: ropaProducts, error } = await supabase
    .from('productos')
    .select('*')
    .in('tipo', ['pantalones', 'sudaderas', 'camisetas', 'chalecos', 'chaquetas']);

if (error) {
    console.error("Error cargando la ropa:", error.message);
}
---

<Layout title="Línea Textil | LocalMarket">
    <section class="px-8 pt-10 pb-20 max-w-7xl mx-auto min-h-screen">
        
        <div class="mb-24 text-center">
            <div class="flex items-center justify-center gap-3 mb-6">
                <span class="w-12 h-[1px] bg-[#facc15]"></span>
                <span class="text-[#facc15] text-[10px] font-black uppercase tracking-[0.5em]">Catálogo</span>
                <span class="w-12 h-[1px] bg-[#facc15]"></span>
            </div>
            <h1 class="text-6xl md:text-[9rem] font-black tracking-[-0.05em] leading-none uppercase italic bg-gradient-to-b from-gray-100 via-gray-400 to-[#333333] bg-clip-text text-transparent pb-4">
                LÍNEA TEXTIL.
            </h1>
            <p class="mt-4 text-[10px] md:text-xs uppercase tracking-[0.6em] text-white/40 font-light max-w-2xl mx-auto leading-loose">
                Ingeniería aplicada al vestuario urbano. Materiales técnicos y cortes precisos para el día a día.
            </p>
        </div>

        <div class="flex flex-col items-center justify-center gap-12 pb-16 mb-20 border-b border-white/5">
            <div class="flex flex-col md:flex-row items-center gap-16 md:gap-32">
                
                <div class="flex flex-col items-center gap-4">
                    <span class="text-[9px] font-black uppercase tracking-[0.6em] text-[#facc15] mb-2">Género</span>
                    <div class="flex gap-10">
                        <button class="filter-btn active relative text-[11px] font-bold uppercase tracking-[0.2em] text-white transition-all" data-filter="genero" data-value="todos">
                            Todos
                            <span class="absolute -bottom-2 left-0 w-full h-[2px] bg-[#facc15] transition-transform origin-left scale-x-100"></span>
                        </button>
                        <button class="filter-btn relative text-[11px] font-bold uppercase tracking-[0.2em] text-white/40 hover:text-white transition-all" data-filter="genero" data-value="hombre">
                            Hombre
                            <span class="absolute -bottom-2 left-0 w-full h-[2px] bg-[#facc15] transition-transform origin-left scale-x-0"></span>
                        </button>
                        <button class="filter-btn relative text-[11px] font-bold uppercase tracking-[0.2em] text-white/40 hover:text-white transition-all" data-filter="genero" data-value="mujer">
                            Mujer
                            <span class="absolute -bottom-2 left-0 w-full h-[2px] bg-[#facc15] transition-transform origin-left scale-x-0"></span>
                        </button>
                        <button class="filter-btn relative text-[11px] font-bold uppercase tracking-[0.2em] text-white/40 hover:text-white transition-all" data-filter="genero" data-value="unisex">
                            Unisex
                            <span class="absolute -bottom-2 left-0 w-full h-[2px] bg-[#facc15] transition-transform origin-left scale-x-0"></span>
                        </button>
                    </div>
                </div>

                <div class="flex flex-col items-center gap-4">
                    <span class="text-[9px] font-black uppercase tracking-[0.6em] text-[#facc15] mb-2">Categoría</span>
                    <div class="flex flex-wrap justify-center gap-10">
                        <button class="filter-btn active relative text-[11px] font-bold uppercase tracking-[0.2em] text-white transition-all" data-filter="tipo" data-value="todos">
                            Todas
                            <span class="absolute -bottom-2 left-0 w-full h-[2px] bg-[#facc15] transition-transform origin-left scale-x-100"></span>
                        </button>
                        <button class="filter-btn relative text-[11px] font-bold uppercase tracking-[0.2em] text-white/40 hover:text-white transition-all" data-filter="tipo" data-value="camisetas">
                            Camisetas
                            <span class="absolute -bottom-2 left-0 w-full h-[2px] bg-[#facc15] transition-transform origin-left scale-x-0"></span>
                        </button>
                        <button class="filter-btn relative text-[11px] font-bold uppercase tracking-[0.2em] text-white/40 hover:text-white transition-all" data-filter="tipo" data-value="sudaderas">
                            Sudaderas
                            <span class="absolute -bottom-2 left-0 w-full h-[2px] bg-[#facc15] transition-transform origin-left scale-x-0"></span>
                        </button>
                        <button class="filter-btn relative text-[11px] font-bold uppercase tracking-[0.2em] text-white/40 hover:text-white transition-all" data-filter="tipo" data-value="pantalones">
                            Pantalones
                            <span class="absolute -bottom-2 left-0 w-full h-[2px] bg-[#facc15] transition-transform origin-left scale-x-0"></span>
                        </button>
                        <button class="filter-btn relative text-[11px] font-bold uppercase tracking-[0.2em] text-white/40 hover:text-white transition-all" data-filter="tipo" data-value="chaquetas">
                            Chaquetas
                            <span class="absolute -bottom-2 left-0 w-full h-[2px] bg-[#facc15] transition-transform origin-left scale-x-0"></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8" id="ropa-grid">
            {ropaProducts?.map((p) => (
                <div class="product-item" 
                     data-genero={p.genero?.toLowerCase()} 
                     data-tipo={p.tipo?.toLowerCase()}>
                    <Card 
                        id={p.id}  
                        title={p.nombre} 
                        price={p.precio} 
                        category={p.cat} 
                        image={p.imagen} 
                    />
                </div>
            ))}
        </div>
    </section>
</Layout>

<script>
    const setupRopaFilters = () => {
        const buttons = document.querySelectorAll('.filter-btn');
        const items = document.querySelectorAll('.product-item');
        
        let activeFilters: Record<string, string> = { 
            genero: 'todos', 
            tipo: 'todos' 
        };

        buttons.forEach(btn => {
            btn.addEventListener('click', () => {
                const group = btn.getAttribute('data-filter');
                const val = btn.getAttribute('data-value');

                if (group === 'genero' || group === 'tipo') {
                    document.querySelectorAll(`.filter-btn[data-filter="${group}"]`).forEach(b => {
                        b.classList.remove('text-white');
                        b.classList.add('text-white/40');
                        const line = b.querySelector('span');
                        if (line) (line as HTMLElement).style.transform = 'scaleX(0)';
                    });

                    btn.classList.remove('text-white/40');
                    btn.classList.add('text-white');
                    const activeLine = btn.querySelector('span');
                    if (activeLine) (activeLine as HTMLElement).style.transform = 'scaleX(1)';

                    activeFilters[group] = val || 'todos';

                    items.forEach((item) => {
                        const el = item as HTMLElement;
                        const itemGenero = el.getAttribute('data-genero');
                        const itemTipo = el.getAttribute('data-tipo');

                        const matchesGenero = activeFilters.genero === 'todos' || itemGenero === activeFilters.genero;
                        const matchesTipo = activeFilters.tipo === 'todos' || itemTipo === activeFilters.tipo;

                        if (matchesGenero && matchesTipo) {
                            el.style.display = "block";
                            setTimeout(() => {
                                el.style.opacity = "1";
                                el.style.transform = "translateY(0)";
                            }, 10);
                        } else {
                            el.style.opacity = "0";
                            el.style.transform = "translateY(20px)";
                            setTimeout(() => el.style.display = "none", 300);
                        }
                    });
                }
            });
        });
    };

    setupRopaFilters();
    document.addEventListener('astro:after-swap', setupRopaFilters);
</script>

<style>
    .product-item {
        transition: opacity 0.4s ease, transform 0.4s ease;
    }
    .filter-btn span {
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
</style>