---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tu Carrito | LocalMarket">
  <section class="px-8 py-20 max-w-5xl mx-auto min-h-screen">
    
    <div class="flex items-center gap-3 mb-12 animate-reveal">
      <span class="w-12 h-[1px] bg-[#facc15]"></span>
      <h1 class="text-5xl font-black uppercase italic text-white tracking-tighter">Tu Carrito</h1>
    </div>

    <div id="cart-container" class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2 space-y-6" id="cart-items-list"></div>

      <div class="lg:col-span-1">
        <div class="bg-white/[0.03] border border-white/10 rounded-[2.5rem] p-8 sticky top-32">
          <h2 class="text-xs font-black uppercase tracking-[0.3em] text-[#facc15] mb-8">Resumen de pedido</h2>
          
          <div class="space-y-4 mb-8">
            <div class="flex justify-between text-sm text-gray-400">
              <span>Subtotal</span>
              <span id="subtotal">0.00€</span>
            </div>
            <div class="flex justify-between text-sm text-gray-400">
              <span>Envío</span>
              <span class="text-green-500 font-bold uppercase text-[10px]">Gratis</span>
            </div>
            <div class="border-t border-white/5 pt-4 flex justify-between text-xl font-black italic text-white">
              <span>TOTAL</span>
              <span id="total-price" class="text-[#facc15]">0.00€</span>
            </div>
          </div>

          <button id="checkout-btn" class="w-full py-5 bg-white text-black font-black uppercase text-[11px] tracking-[0.2em] rounded-2xl hover:bg-[#facc15] transition-all shadow-xl active:scale-95">
            Finalizar Compra
          </button>

          <div id="checkout-form" class="hidden mt-8 pt-8 border-t border-white/10 space-y-4 animate-reveal">
            <div>
              <label class="text-[9px] text-gray-400 uppercase tracking-widest">Dirección de Envío</label>
              <input type="text" id="ship-address" class="w-full bg-black border border-white/10 rounded-lg p-3 text-white text-sm mt-1" placeholder="Tu calle y número">
            </div>
            <div>
              <label class="text-[9px] text-gray-400 uppercase tracking-widest">Método de Pago</label>
              <select id="pay-method" class="w-full bg-black border border-white/10 rounded-lg p-3 text-white text-sm mt-1">
                <option value="tarjeta">Tarjeta de Crédito</option>
                <option value="bizum">Bizum</option>
                <option value="reembolso">Contra Reembolso</option>
              </select>
            </div>
            <button id="confirm-purchase-btn" class="w-full py-4 bg-[#facc15] text-black font-black uppercase text-[10px] tracking-widest rounded-xl hover:bg-white transition-all">
              Confirmar Pedido
            </button>
          </div>
          
          <a href="/" class="block text-center mt-6 text-[9px] uppercase tracking-widest text-white/30 hover:text-white transition-colors">
            ← Continuar comprando
          </a>
        </div>
      </div>
    </div>

    <div id="empty-cart-msg" class="hidden text-center py-32 border border-dashed border-white/10 rounded-[3rem]">
        <p class="text-gray-500 italic mb-8 tracking-widest uppercase text-xs">Tu selección está vacía</p>
        <a href="/" class="px-10 py-4 bg-white/5 border border-white/10 rounded-xl hover:bg-white hover:text-black transition-all uppercase text-[10px] font-black tracking-widest">
            Explorar catálogo
        </a>
    </div>
  </section>
</Layout>

<script>
  import { cartItems, removeCartItem, cartTotal, updateCartItemQuantity } from '../store/cartStore.js';
  import { supabase } from '../lib/supabaseClient';

  const updateCartUI = () => {
    const listElement = document.getElementById('cart-items-list');
    const emptyMsg = document.getElementById('empty-cart-msg');
    const container = document.getElementById('cart-container');
    const totalDisplay = document.getElementById('total-price');
    const subtotalDisplay = document.getElementById('subtotal');
    
    const items = cartItems.get();

    if (items.length === 0) {
      container?.classList.add('hidden');
      emptyMsg?.classList.remove('hidden');
      if (totalDisplay) totalDisplay.innerText = "0.00€";
      if (subtotalDisplay) subtotalDisplay.innerText = "0.00€";
      return;
    } else {
      container?.classList.remove('hidden');
      emptyMsg?.classList.add('hidden');
    }

    if (listElement) {
      listElement.innerHTML = items.map((item: any, index: number) => `
        <div class="flex items-center gap-6 bg-white/[0.04] border border-white/10 p-6 rounded-[1.5rem]">
          <img src="${item.imagen}" class="w-24 h-24 object-cover rounded-xl border border-white/5 bg-[#111]" />
          <div class="flex-grow">
            <h3 class="font-black uppercase italic text-base text-white tracking-wide mb-2">${item.nombre}</h3>
            <div class="flex items-center gap-4">
              <p class="text-[#facc15] font-mono text-sm font-bold">${item.precio}€</p>
              <div class="flex items-center bg-black/40 border border-white/10 rounded-lg overflow-hidden">
                <button class="qty-btn-minus px-3 py-1 text-white/50 hover:text-white" data-index="${index}">-</button>
                <span class="text-white font-black text-xs w-8 text-center">${item.cantidad || 1}</span>
                <button class="qty-btn-plus px-3 py-1 text-white/50 hover:text-white" data-index="${index}">+</button>
              </div>
            </div>
          </div>
          <button class="remove-item-btn bg-red-500/10 text-red-500 px-6 py-3 rounded-lg border border-red-500/20 text-[10px] font-black uppercase" data-index="${index}">Eliminar</button>
        </div>`).join('');
    }

    const totalString = `${cartTotal.get().toFixed(2)}€`;
    if (totalDisplay) totalDisplay.innerText = totalString;
    if (subtotalDisplay) subtotalDisplay.innerText = totalString;

    document.querySelectorAll('.remove-item-btn').forEach(btn => btn.addEventListener('click', (e) => removeCartItem(Number((e.currentTarget as HTMLButtonElement).dataset.index))));
    document.querySelectorAll('.qty-btn-minus').forEach(btn => btn.addEventListener('click', (e) => updateCartItemQuantity(Number((e.currentTarget as HTMLButtonElement).dataset.index), -1)));
    document.querySelectorAll('.qty-btn-plus').forEach(btn => btn.addEventListener('click', (e) => updateCartItemQuantity(Number((e.currentTarget as HTMLButtonElement).dataset.index), 1)));
  };

  // Lógica de Checkout
  const checkoutBtn = document.getElementById('checkout-btn');
  const checkoutForm = document.getElementById('checkout-form');
  const confirmBtn = document.getElementById('confirm-purchase-btn');

  checkoutBtn?.addEventListener('click', async () => {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) { 
        document.dispatchEvent(new CustomEvent('app:toast', { detail: { msg: 'Debes iniciar sesión para comprar', type: 'error' } }));
        setTimeout(() => window.location.href = '/login', 1500);
        return; 
    }
    
    // Autocompletar dirección si existe en profile
    const { data: profile } = await supabase.from('profiles').select('address').eq('id', session.user.id).single();
    if (profile?.address) (document.getElementById('ship-address') as HTMLInputElement).value = profile.address;

    checkoutForm?.classList.remove('hidden');
    checkoutBtn.classList.add('hidden');
  });

  confirmBtn?.addEventListener('click', async () => {
    const address = (document.getElementById('ship-address') as HTMLInputElement).value;
    const payment = (document.getElementById('pay-method') as HTMLSelectElement).value;

    if (!address) { 
        document.dispatchEvent(new CustomEvent('app:toast', { detail: { msg: 'Introduce una dirección de envío', type: 'error' } }));
        return; 
    }

    // Feedback visual opcional en el botón mientras procesa
    const originalText = confirmBtn.innerText;
    confirmBtn.innerText = "PROCESANDO...";
    confirmBtn.classList.add('opacity-50', 'pointer-events-none');

    const { data: { session } } = await supabase.auth.getSession();
    const { error } = await supabase.from('pedidos').insert([{ 
        user_id: session?.user.id, 
        total: cartTotal.get(), 
        productos: cartItems.get(), 
        estado: 'Pagado',
        direccion_envio: address,
        metodo_pago: payment
    }]);

    if (error) {
        confirmBtn.innerText = originalText;
        confirmBtn.classList.remove('opacity-50', 'pointer-events-none');
        document.dispatchEvent(new CustomEvent('app:toast', { detail: { msg: "Error: " + error.message, type: 'error' } }));
    } else {
        document.dispatchEvent(new CustomEvent('app:toast', { detail: { msg: '¡Pedido realizado con éxito!', type: 'success' } }));
        cartItems.set([]); // Vaciar carrito
        
        // Retraso para que el usuario pueda ver el toast antes de redirigir
        setTimeout(() => {
            window.location.href = '/mi-cuenta';
        }, 1500);
    }
  });

  updateCartUI();
  cartItems.subscribe(updateCartUI);
</script>