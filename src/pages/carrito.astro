---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tu Carrito | LocalMarket">
  <section class="px-8 py-20 max-w-5xl mx-auto min-h-screen">
    
    <div class="flex items-center gap-3 mb-12 animate-reveal">
      <span class="w-12 h-[1px] bg-[#facc15]"></span>
      <h1 class="text-5xl font-black uppercase italic tracking-tighter text-white">Tu Carrito</h1>
    </div>

    <div id="cart-container" class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      
      <div class="lg:col-span-2 space-y-6" id="cart-items-list">
        </div>

      <div class="lg:col-span-1">
        <div class="bg-white/[0.03] border border-white/10 rounded-[2.5rem] p-8 sticky top-32">
          <h2 class="text-xs font-black uppercase tracking-[0.3em] text-[#facc15] mb-8">Resumen de pedido</h2>
          
          <div class="space-y-4 mb-8">
            <div class="flex justify-between text-sm text-gray-400">
              <span>Subtotal</span>
              <span id="subtotal">0.00€</span>
            </div>
            <div class="flex justify-between text-sm text-gray-400">
              <span>Envío</span>
              <span class="text-green-500 font-bold uppercase text-[10px]">Gratis</span>
            </div>
            <div class="border-t border-white/5 pt-4 flex justify-between text-xl font-black italic text-white">
              <span>TOTAL</span>
              <span id="total-price" class="text-[#facc15]">0.00€</span>
            </div>
          </div>

          <button 
            onclick="window.location.href='/confirmacion'"
            class="w-full py-5 bg-white text-black font-black uppercase text-[11px] tracking-[0.2em] rounded-2xl hover:bg-[#facc15] transition-all shadow-xl active:scale-95"
          >
            Finalizar Compra
          </button>
          
          <a href="/" class="block text-center mt-6 text-[9px] uppercase tracking-widest text-white/30 hover:text-white transition-colors">
            ← Continuar comprando
          </a>
        </div>
      </div>
    </div>

    <div id="empty-cart-msg" class="hidden text-center py-32 border border-dashed border-white/10 rounded-[3rem]">
        <p class="text-gray-500 italic mb-8 tracking-widest uppercase text-xs">Tu selección está vacía</p>
        <a href="/" class="px-10 py-4 bg-white/5 border border-white/10 rounded-xl hover:bg-white hover:text-black transition-all uppercase text-[10px] font-black tracking-widest">
            Explorar catálogo
        </a>
    </div>

  </section>
</Layout>

<script>
  // ¡Importante! Ahora también importamos updateCartItemQuantity
  import { cartItems, removeCartItem, cartTotal, updateCartItemQuantity } from '../store/cartStore.js';

  const updateCartUI = () => {
    const listElement = document.getElementById('cart-items-list');
    const emptyMsg = document.getElementById('empty-cart-msg');
    const container = document.getElementById('cart-container');
    const totalDisplay = document.getElementById('total-price');
    const subtotalDisplay = document.getElementById('subtotal');
    
    const items = cartItems.get();

    if (items.length === 0) {
      container?.classList.add('hidden');
      emptyMsg?.classList.remove('hidden');
      if (totalDisplay) totalDisplay.innerText = "0.00€";
      if (subtotalDisplay) subtotalDisplay.innerText = "0.00€";
      return;
    } else {
      container?.classList.remove('hidden');
      emptyMsg?.classList.add('hidden');
    }

    if (listElement) {
      listElement.innerHTML = items.map((item: any, index: number) => {
        const qty = item.cantidad || 1;
        const totalPorItem = (parseFloat(item.precio) * qty).toFixed(2);
        
        return `
        <div class="flex items-center gap-6 bg-white/[0.04] border border-white/10 p-6 rounded-[1.5rem] mb-4 hover:border-white/30 transition-all shadow-sm">
          <img src="${item.imagen}" class="w-24 h-24 object-cover rounded-xl border border-white/5 bg-[#111]" />
          <div class="flex-grow">
            <h3 class="font-black uppercase italic text-base md:text-lg text-white tracking-wide mb-2">${item.nombre}</h3>
            
            <div class="flex items-center gap-4">
              <p class="text-[#facc15] font-mono text-sm md:text-base font-bold">${item.precio}€</p>
              
              <div class="flex items-center bg-black/40 border border-white/10 rounded-lg overflow-hidden">
                <button class="qty-btn-minus px-3 py-1 text-white/50 hover:text-white hover:bg-white/10 transition-colors" data-index="${index}">-</button>
                <span class="text-white font-sans font-black text-xs w-8 text-center">${qty}</span>
                <button class="qty-btn-plus px-3 py-1 text-white/50 hover:text-white hover:bg-white/10 transition-colors" data-index="${index}">+</button>
              </div>
            </div>
            
            ${qty > 1 ? `<p class="text-[11px] text-gray-300 font-bold uppercase tracking-widest mt-3">Subtotal de este artículo: <span class="text-white font-black">${totalPorItem}€</span></p>` : ''}
          </div>
          
          <button class="remove-item-btn flex items-center justify-center bg-red-500/10 text-red-500 hover:bg-red-500 hover:text-white transition-all text-[11px] font-black uppercase px-6 py-3 rounded-lg border border-red-500/20" data-index="${index}">
            Eliminar
          </button>
        </div>
      `}).join('');
    }

    const totalString = `${cartTotal.get().toFixed(2)}€`;
    if (totalDisplay) totalDisplay.innerText = totalString;
    if (subtotalDisplay) subtotalDisplay.innerText = totalString;

    // Asignar eventos de borrado total
    document.querySelectorAll('.remove-item-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const index = Number(target.getAttribute('data-index'));
        removeCartItem(index);
      });
    });

    // NUEVO: Asignar eventos para restar cantidad
    document.querySelectorAll('.qty-btn-minus').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const index = Number(target.getAttribute('data-index'));
        updateCartItemQuantity(index, -1);
      });
    });

    // NUEVO: Asignar eventos para sumar cantidad
    document.querySelectorAll('.qty-btn-plus').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const index = Number(target.getAttribute('data-index'));
        updateCartItemQuantity(index, 1);
      });
    });
  };

  updateCartUI();
  cartItems.subscribe(updateCartUI);
  document.addEventListener('astro:after-swap', () => {
    updateCartUI();
    cartItems.subscribe(updateCartUI);
  });
</script>