---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mi Cuenta | LocalMarket">
    <section class="px-8 pt-24 pb-20 max-w-5xl mx-auto min-h-screen">
        
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between mb-12 animate-reveal">
            <div>
                <h1 class="text-4xl md:text-5xl font-black uppercase italic text-white mb-2" id="user-greeting">
                    Cargando...
                </h1>
                <p class="text-xs text-[#facc15] uppercase tracking-widest">Miembro nivel Gold</p>
            </div>
            <button id="logout-btn" class="mt-6 md:mt-0 px-6 py-3 bg-red-500/10 text-red-500 border border-red-500/20 text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-red-500 hover:text-white transition-all">
                Cerrar Sesión
            </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 animate-reveal" style="animation-delay: 0.1s;">
            
            <div class="col-span-1 md:col-span-2 bg-[#1a1a1a] p-8 rounded-[2rem] border border-white/10">
                <h2 class="text-xs font-black uppercase tracking-[0.3em] text-white/50 mb-6">Últimos Pedidos</h2>
                
                <div class="bg-black/50 border border-white/5 p-6 rounded-2xl flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                    <div>
                        <p class="text-white font-bold text-sm uppercase">Pedido #LM-2026</p>
                        <p class="text-gray-500 text-[10px] uppercase tracking-widest mt-1">2 artículos • Entregado</p>
                    </div>
                    <div class="text-right">
                        <p class="text-[#facc15] font-black text-lg">189.99€</p>
                        <button class="text-white/40 hover:text-white text-[9px] uppercase tracking-widest mt-1 transition-colors">Ver factura</button>
                    </div>
                </div>
            </div>

            <div class="bg-[#1a1a1a] p-8 rounded-[2rem] border border-white/10 relative overflow-hidden">
                
                <div id="profile-view" class="flex flex-col h-full justify-between transition-opacity duration-300">
                    <div>
                        <h2 class="text-xs font-black uppercase tracking-[0.3em] text-white/50 mb-6">Mis Datos</h2>
                        <div class="space-y-4">
                            <div>
                                <p class="text-[9px] text-gray-500 uppercase tracking-widest">Nombre</p>
                                <p class="text-sm font-bold text-white truncate" id="view-name">...</p>
                            </div>
                            <div>
                                <p class="text-[9px] text-gray-500 uppercase tracking-widest">Email</p>
                                <p class="text-sm font-bold text-white truncate" id="view-email">...</p>
                            </div>
                            <div>
                                <p class="text-[9px] text-gray-500 uppercase tracking-widest">Dirección de Envío</p>
                                <p class="text-sm font-bold text-white" id="view-address">...</p>
                            </div>
                        </div>
                    </div>
                    <button id="edit-profile-btn" class="w-full mt-8 py-3 bg-white/5 border border-white/10 rounded-xl text-white text-[10px] font-black uppercase tracking-widest hover:bg-[#facc15] hover:text-black hover:border-[#facc15] transition-all">
                        Editar Perfil
                    </button>
                </div>

                <form id="profile-edit-form" class="hidden flex-col h-full justify-between absolute inset-0 bg-[#1a1a1a] p-8 z-10 transition-all duration-300">
                    <div>
                        <h2 class="text-xs font-black uppercase tracking-[0.3em] text-[#facc15] mb-6">Editando Perfil</h2>
                        <div class="space-y-3">
                            <div>
                                <label class="text-[9px] text-gray-500 uppercase tracking-widest ml-1">Nombre</label>
                                <input type="text" id="edit-name" required class="w-full bg-black border border-white/10 rounded-lg px-3 py-2 text-white focus:border-[#facc15] outline-none text-sm">
                            </div>
                            <div>
                                <label class="text-[9px] text-gray-500 uppercase tracking-widest ml-1">Email</label>
                                <input type="email" id="edit-email" required class="w-full bg-black border border-white/10 rounded-lg px-3 py-2 text-white focus:border-[#facc15] outline-none text-sm">
                            </div>
                            <div>
                                <label class="text-[9px] text-gray-500 uppercase tracking-widest ml-1">Dirección</label>
                                <textarea id="edit-address" required rows="2" class="w-full bg-black border border-white/10 rounded-lg px-3 py-2 text-white focus:border-[#facc15] outline-none text-sm resize-none"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="flex gap-3 mt-4">
                        <button type="button" id="cancel-edit-btn" class="flex-1 py-3 bg-white/5 border border-white/10 rounded-xl text-white text-[10px] font-black uppercase tracking-widest hover:bg-red-500/20 hover:border-red-500/50 hover:text-red-400 transition-all">
                            Cancelar
                        </button>
                        <button type="submit" id="save-edit-btn" class="flex-1 py-3 bg-[#facc15] border border-[#facc15] rounded-xl text-black text-[10px] font-black uppercase tracking-widest hover:bg-white transition-all">
                            Guardar
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </section>
</Layout>

<script>
    const setupAccount = () => {
        // Elementos Generales
        const greeting = document.getElementById('user-greeting');
        const logoutBtn = document.getElementById('logout-btn');

        // Elementos UI Modo Vista
        const viewMode = document.getElementById('profile-view');
        const viewName = document.getElementById('view-name');
        const viewEmail = document.getElementById('view-email');
        const viewAddress = document.getElementById('view-address');
        const editBtn = document.getElementById('edit-profile-btn');

        // Elementos UI Modo Edición
        const editMode = document.getElementById('profile-edit-form');
        const editName = document.getElementById('edit-name') as HTMLInputElement;
        const editEmail = document.getElementById('edit-email') as HTMLInputElement;
        const editAddress = document.getElementById('edit-address') as HTMLTextAreaElement;
        const cancelBtn = document.getElementById('cancel-edit-btn');
        const saveBtn = document.getElementById('save-edit-btn');

        // 1. Verificación de Seguridad
        const storedUser = localStorage.getItem('localmarket_user');
        if (!storedUser) {
            window.location.href = '/login';
            return;
        }

        // Recuperamos el usuario
        let user = JSON.parse(storedUser);
        
        // Añadimos una dirección por defecto si acaba de registrarse en la demo
        if (!user.address) {
            user.address = "Calle Real 42, Villanueva Mesía";
        }

        // 2. Función para pintar los datos en pantalla
        const renderData = () => {
            if (greeting) greeting.innerText = `Hola, ${user.name}`;
            if (viewName) viewName.innerText = user.name;
            if (viewEmail) viewEmail.innerText = user.email;
            if (viewAddress) viewAddress.innerText = user.address;
        };

        // Pintamos los datos al arrancar
        renderData();

        // 3. Activar el Modo Edición
        editBtn?.addEventListener('click', () => {
            // Rellenar los inputs con los datos actuales
            if (editName) editName.value = user.name;
            if (editEmail) editEmail.value = user.email;
            if (editAddress) editAddress.value = user.address;

            // Intercambiar pantallas
            viewMode?.classList.add('opacity-0', 'pointer-events-none');
            setTimeout(() => {
                editMode?.classList.remove('hidden');
                editMode?.classList.add('flex');
            }, 150);
        });

        // 4. Cancelar Edición
        cancelBtn?.addEventListener('click', () => {
            editMode?.classList.add('hidden');
            editMode?.classList.remove('flex');
            viewMode?.classList.remove('opacity-0', 'pointer-events-none');
        });

        // 5. Guardar Cambios (El Submit del Formulario)
        editMode?.addEventListener('submit', (e) => {
            e.preventDefault();
            
            // Efecto visual de guardado
            if (saveBtn) saveBtn.innerText = "GUARDANDO...";

            setTimeout(() => {
                // Actualizar el objeto con los nuevos datos
                user.name = editName.value;
                user.email = editEmail.value;
                user.address = editAddress.value;

                // Guardarlo en la "base de datos" del navegador
                localStorage.setItem('localmarket_user', JSON.stringify(user));

                // Volver a pintar todo y cerrar el formulario
                renderData();
                editMode.classList.add('hidden');
                editMode.classList.remove('flex');
                viewMode?.classList.remove('opacity-0', 'pointer-events-none');
                
                if (saveBtn) saveBtn.innerText = "GUARDAR";
            }, 400); // Pequeño retraso para dar sensación de procesamiento
        });

        // 6. Lógica de Cerrar Sesión
        logoutBtn?.addEventListener('click', () => {
            localStorage.removeItem('localmarket_user');
            window.location.href = '/login';
        });
    };

    setupAccount();
    document.addEventListener('astro:after-swap', setupAccount);
</script>